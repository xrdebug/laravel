{
    "name": "xrdebug/laravel",
    "description": "Laravel client for xrDebug",
    "homepage": "https://xrdebug.com",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Rodolfo Berrios",
            "email": "rodolfo@chevere.org",
            "homepage": "https://chevere.org"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "xrdebug/php": "^3",
        "illuminate/contracts": "^10|^11|^12|^13",
        "illuminate/database": "^10|^11|^12|^13",
        "illuminate/queue": "^10|^11|^12|^13",
        "illuminate/support": "^10|^11|^12|^13"
    },
    "require-dev": {
        "laravel/framework": "^10|^11|^12|^13",
        "orchestra/testbench": "^9|^10|^11",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "symplify/easy-coding-standard": "^12.2",
        "symfony/http-foundation": "^5.4|^6.4|^7.3|^8"
    },
    "autoload": {
        "files": [
            "src/functions.php"
        ],
        "psr-4": {
            "Chevere\\xrDebug\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chevere\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chevere\\xrDebug\\Laravel\\XrServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "all": [
            "composer phpstan",
            "composer test",
            "composer test-coverage",
            "composer infection -- --skip-initial-tests --coverage=coverage/logs"
        ],
        "infection": [
            "Composer\\Config::disableProcessTimeout",
            "infection -j10"
        ],
        "infection-filter": "sh -c 'sh -c \"composer infection -- --filter=$0 --test-framework-options=--filter=$0\"' $1",
        "phpstan": "vendor/bin/phpstan analyze src/ --memory-limit 512M --level 9",
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit -c phpunit.xml"
        ],
        "test-coverage": [
            "Composer\\Config::disableProcessTimeout",
            "php -d memory_limit=1G vendor/bin/phpunit -c phpunit.xml"
        ],
        "cs-update": "mkdir -p .ecs && cd .ecs && curl -O https://raw.githubusercontent.com/chevere/code-style/main/.ecs/ecs-chevere.php",
        "cs-fix": "vendor/bin/ecs --config='.ecs/ecs.php' check src --fix",
        "open-coverage": "open coverage/logs/html/index.html",
        "open-infection": "open coverage/logs/html/infection.html"
    },
    "scripts-descriptions": {
        "all": "Runs all checks",
        "infection": "Runs infection",
        "infection-filter": "Runs infection filtered (args infection-filter phpunit-filter)",
        "phpstan": "Runs phpstan",
        "test": "Run test suite",
        "test-coverage": "Run test suite (coverage)",
        "cs-update": "Update Chevere code style definition",
        "cs-fix": "Update Chevere code style definition",
        "open-coverage": "Open code coverage report",
        "open-infection": "Open infection report"
    }
}
